# Copy to .env (never commit it). All optional except DJANGO_SECRET_KEY in production.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PROVIDERS=live            # "fake" = deterministic offline data (tests, demos)
OPEN_METEO_API_KEY=       # optional commercial key; set OPEN_METEO_URL=https://customer-api.open-meteo.com with it
TRUCK_MAX_MPH=65
PLAN_RATE_LIMIT=20/min
